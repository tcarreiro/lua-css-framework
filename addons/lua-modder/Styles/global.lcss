.main-menu {
	background_color: #FF0000;
}

.main-menu:hover {
	background_color: #00FF00;
}

.main-menu:pressed {
	background_color: #0000FF;
}

.main-menu-button {
	background_color: #00FFFF;
}

.main-menu-button:hover {
	background_color: #FF00FF;
}

.main-menu-button:pressed {
	background_color: #FFFF00;
}

