; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LuaFramework"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

LuaUiBridge="*uid://pmf12v1pf4v8"
LuaUiEventBridge="*uid://cv1cyef1ru6rb"
LuaContentBridge="*uid://bjjt5pn0g8ry8"
GdssRuntime="*uid://yu6lhnx763yp"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="LuaFramework"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdss/plugin.cfg", "res://addons/lua-gdextension/plugin.cfg")

[gdss]

internal/initialized=true
storage/save_path="res://demo/css/gdss-components.tgdss"
editor/use_minimap=true
editor/show_outline=true
storage/save_paths=PackedStringArray("res://demo/css/gdss-components.tgdss")
storage/save_uid="uid://dnprrgv3jpwl6"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
