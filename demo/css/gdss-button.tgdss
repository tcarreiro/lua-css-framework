@import "res://demo/css/gdss-colors.tgdss"

@instance var padding_left: 10;
@instance var padding_right: 10;
@instance var padding_top: 5;
@instance var padding_bottom: 5;
@instance var border_left: 2;
@instance var border_right: 2;
@instance var border_top: 2;
@instance var border_bottom: 2;
@instance var corner_radius_top_left: 10;
@instance var corner_radius_top_right: 10;
@instance var corner_radius_bottom_left: 10;
@instance var corner_radius_bottom_right: 10;
@instance var font_size: 16;
@instance var icon_max_width: 16;

Button {
	padding_left: $padding_left 
	padding_right: $padding_right 
	padding_top: $padding_top 
	padding_bottom: $padding_bottom 
	border_left: $border_left 
	border_right: $border_right 
	border_top: $border_top 
	border_bottom: $border_bottom 
	corner_radius_top_left: $corner_radius_top_left
	corner_radius_top_right: $corner_radius_top_right
	corner_radius_bottom_left: $corner_radius_bottom_left
	corner_radius_bottom_right: $corner_radius_bottom_right
	
	transition_time: 0.5
	transition_func: BACK
	transition_type: EASE_OUT
	font_size: $font_size
	icon_max_width: $icon_max_width 
	
	primary {
		font_color: $c_gray_100
		bg_color: $c_blue_45 
		border_color: $c_blue_30 
		
		:hover {
			bg_color: $c_blue_60 
		}
		
		:pressed, :hover_pressed  {
			bg_color: $c_blue_25 
		}
	}
	
	secondary {
		font_color: $c_blue_45
		bg_color: $c_blue_100 
		border_color: $c_blue_30 
		
		:hover {
			bg_color: $c_blue_95 
		}
		
		:pressed, :hover_pressed  {
			font_color: $c_blue_100
			bg_color: $c_blue_45 
		}
	}
	
	accent {
		font_color: $c_gray_100
		bg_color: $c_green_50 
		border_color: $c_green_35 
		
		:hover {
			bg_color: $c_green_70 
		}
		
		:pressed, :hover_pressed  {
			bg_color: $c_green_30 
		}
	}
	
	negative {
		font_color: $c_gray_100
		bg_color: $c_red_50 
		border_color: $c_red_35 
		
		:hover {
			bg_color: $c_red_65 
		}
		
		:pressed, :hover_pressed  {
			bg_color: $c_red_35 
		}
	}
	
}
