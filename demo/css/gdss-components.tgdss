@import "res://demo/css/gdss-colors.tgdss"

@instance var bg_color: "res://demo/css/background.png"; # Pode ser alterado via codigo

MarginContainer {
	margin_bottom: 5
	margin_left: 5
	margin_right: 5
	margin_top: 5
}

Panel {
	corner_radius: 20 20 20 20
	
	Tipo1 {
		corner_radius: 15 15 15 15
		bg_color: texture($bg_color)
	}
	
	Tipo2 {
		bg_color: $c_red_50
	}
}


Button {
	T1 {
		padding: 10 10 5 5
		font_color: $c_gray_00
		bg_color: texture($bg_color)
		corner_radius: 10 10 10 10
		font_size: 24
		border: 5 5 5 5
		border_color: linear_gradient($c_blue_40, darken($c_blue_40, 0.8), -45, 0, 100)
		
		transition_time: 0.5
		transition_func: BACK
		transition_type: EASE_OUT
		
		transform_enabled: true
		transform_position_x: 0
		
		icon_max_width: 16
		
		:hover {
			bg_color: $c_red_25
			font_color: $c_gray_50
			border_color: linear_gradient(darken($c_blue_40, 0.8), $c_blue_40, -45, 0, 100)
			transform_position_x: 5
		}
		
		:pressed, :hover_pressed  {
			bg_color: $c_red_05
			font_color: $c_gray_50
			transform_position_x: 5
		}
	}
	
}

Label {
	MyButton {
		font_color: $c_red_00
	}
}

