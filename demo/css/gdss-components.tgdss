# @chunk Properties
@instance var padding_left: 10
@instance var padding_right: 10
@instance var padding_top: 10
@instance var padding_bottom: 10
@instance var border_color: "";
@instance var border_left: 0
@instance var border_right: 0
@instance var border_top: 0;
@instance var border_bottom: 0
@instance var corner_radius_top_left: 0
@instance var corner_radius_top_right: 0
@instance var corner_radius_bottom_left: 0
@instance var corner_radius_bottom_right: 0
@instance var font_size: 16
@instance var icon_max_width: 16
@instance var bg_color: "res://demo/assets/images/background.png"
