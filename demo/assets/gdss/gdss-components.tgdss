# @chunk Button
Button {
	font_color: $c_gray_100
	bg_color: $c_blue_45
	
	padding: 10 10 5 5 
	border: 0 0 0 0
	corner_radius: 0 0 0 0
		
	main-menu-button {
		transition_time: 0.5
		transition_func: BACK
		transition_type: EASE_OUT
		
		:hover {
			bg_color: $c_blue_60 
		}
		
		:pressed, :hover_pressed  {
			bg_color: $c_blue_25 
		}
	}
}

# @chunk Panel
Panel, PanelContainer {
	bg_color: ALICE_BLUE
	
	main-menu {
	}
	
	modal {
		bg_color: "#000000AA"
	}

}
# @chunk CheckBox
CheckBox {
	
}
# @chunk ColorPicker
ColorPicker, ColorPickerButton {
	
}
# @chunk Input
LineEdit, TextEdit {
	font_color: BLACK
	bg_color: "#00000066"
	
	primary {
		transition_time: 0.5
		transition_func: BACK
		transition_type: EASE_OUT
		
		font_color: $c_gray_10
		bg_color: $c_gray_70 
		font_size: 18
		caret_color: BLACK
		border: 0 0 0 1
		border_color: BLACK
		padding: 5 5 5 5
		:focus {
			bg_color: $c_blue_85 
		}
	}
}

Label {
	font_color: $c_gray_10 
}
# @chunk Scroll
HSlider, VSlider, VScrollBar, HScrollBar {
	
}

ScrollContainer {
	bg_color: $c_gray_15 
}
# @chunk Texture
TextureRect {
	
}
# @chunk Tab
TabContainer, TabBar {
}
# @chunk Div
BoxContainer, HBoxContainer, VBoxContainer {
}

MarginContainer {
	margin_bottom: 5
	margin_left: 5
	margin_right: 5
	margin_top: 5
	
	main-menu {
	}
}